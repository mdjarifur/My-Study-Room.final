{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": [
    {
      "site": "reading-room-14320",
      "redirects": [
        {
          "source": "/**",
          "destination": "https://study-room-14320.web.app",
          "type": 301
        }
      ]
    },
    {
      "site": "study-room-14320",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.@(html|js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/admin",
          "destination": "/admin.html"
        }
      ]
    }
  ]
}