{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      ".read": false,
      ".write": false
    },
    "users": {
      ".indexOn": [
        "status"
      ],
      ".read": "auth != null && root.child('config').child('ownerUid').val() === auth.uid",
      ".write": "auth != null && root.child('config').child('ownerUid').val() === auth.uid",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['name','mobile','email','createdAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
          },
          "mobile": {
            ".validate": "newData.isString() && newData.val().matches(/^01[3-9][0-9]{8}$/)"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "createdAt": {
            ".validate": "newData.val() === now || newData.val() === data.val()"
          },
          "$other": {
            ".validate": false
          }
        },
        "status": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.val() === 'pending'",
          ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'suspended' || newData.val() === 'blocked' || newData.val() === 'rejected')"
        },
        "room": {
          ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 40"
        },
        "slot": {
          ".validate": "newData.val() === 'p1' || newData.val() === 'p2'"
        },
        "statusReason": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "statusUpdatedAt": {
          ".validate": "newData.isNumber()"
        },
        "statusUpdatedBy": {
          ".validate": "newData.isString()"
        },
        "stats": {
          ".write": "auth != null && auth.uid === $uid && root.child('users').child($uid).child('status').val() === 'approved'",
          "totalMinutes": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "todayMinutes": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440"
          },
          "prayersToday": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
          },
          "tasksDone": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "lastActiveAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "prayerLogs": {
          ".write": "auth != null && auth.uid === $uid && root.child('users').child($uid).child('status').val() === 'approved'",
          "$date": {
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isString() && newData.val().matches(/^[01]{5}$/)"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "registration_requests": {
      ".indexOn": [
        "state"
      ],
      ".read": "auth != null && root.child('config').child('ownerUid').val() === auth.uid",
      ".write": "auth != null && root.child('config').child('ownerUid').val() === auth.uid",
      "$uid": {
        "application": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['name','mobile','email','requestedAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40"
          },
          "mobile": {
            ".validate": "newData.isString() && newData.val().matches(/^01[3-9][0-9]{8}$/)"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "message": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "requestedAt": {
            ".validate": "newData.val() === now || newData.val() === data.val()"
          },
          "$other": {
            ".validate": false
          }
        },
        "state": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.val() === 'pending'",
          ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'info_requested' || newData.val() === 'approved' || newData.val() === 'rejected')"
        },
        "rejectionReason": {
          ".read": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "infoRequest": {
          ".read": "auth != null && auth.uid === $uid",
          "message": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "requestedAt": {
            ".validate": "newData.isNumber()"
          },
          "response": {
            ".write": "auth != null && auth.uid === $uid && root.child('registration_requests').child($uid).child('state').val() === 'info_requested'",
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
          },
          "respondedAt": {
            ".write": "auth != null && auth.uid === $uid && root.child('registration_requests').child($uid).child('state').val() === 'info_requested'",
            ".validate": "newData.val() === now || newData.val() === data.val()"
          },
          "$other": {
            ".validate": false
          }
        },
        "adminNote": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "reviewedBy": {
          ".validate": "newData.isString()"
        },
        "reviewedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "chat_controls": {
      ".read": "auth != null && root.child('config').child('ownerUid').val() === auth.uid",
      ".write": "auth != null && root.child('config').child('ownerUid').val() === auth.uid",
      "global": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved'",
        ".validate": "newData.isBoolean()"
      },
      "pairs": {
        "$room": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && root.child('users').child(auth.uid).child('room').val() === $room",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "audit_logs": {
      ".indexOn": [
        "at"
      ],
      ".read": true,
      "$logId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['action','by','at'])",
        "action": {
          ".validate": "newData.isString() && (newData.val() === 'approve' || newData.val() === 'reject' || newData.val() === 'request_info' || newData.val() === 'suspend' || newData.val() === 'unsuspend' || newData.val() === 'block' || newData.val() === 'unblock' || newData.val() === 'password_reset' || newData.val() === 'delete_user' || newData.val() === 'assign_room' || newData.val() === 'chat_toggle_global' || newData.val() === 'chat_toggle_pair' || newData.val() === 'note' || newData.val() === 'chat_delete' || newData.val() === 'room_edit')"
        },
        "by": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "targetUid": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "targetName": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "details": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$room": {
        ".read": true,
        ".write": true,
        "$p": {
          ".validate": "($p === 'p1' || $p === 'p2' || $p === 'exam' || $p === 'chat' || $p === 'bk' || $p === 'pres' || $p === 'pass_request')"
        }
      }
    },
    "room_meta": {
      ".read": true,
      ".write": true,
      "$room": {
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'trial' || newData.val() === 'approved' || newData.val() === 'suspended' || newData.val() === 'expired' || newData.val() === 'blocked')"
        },
        "expiresAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms_v2": {
      "$room": {
        ".read": true,
        ".write": true,
        "meta": {
          ".validate": "newData.hasChildren(['name','createdAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "trialEnds": {
            ".validate": "newData.isNumber()"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'trial' || newData.val() === 'approved' || newData.val() === 'suspended' || newData.val() === 'expired' || newData.val() === 'blocked')"
          },
          "max": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          "$mid": {
            ".validate": "newData.hasChildren(['name','goal','joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "cls": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "goal": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },
            "mobile": {
              ".validate": "newData.isString() && newData.val().matches(/^01[3-9][0-9]{8}$/)"
            },
            "bio": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "creator": {
              ".validate": "newData.isBoolean()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "leaderboard": {
      ".read": true,
      ".write": true,
      "days": {
        "$d": {
          ".validate": "$d.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$k": {
            ".validate": "newData.hasChildren(['n','m'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "g": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "m": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440"
            },
            "k": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
            },
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 2"
            },
            "l": {
              ".validate": "newData.isBoolean()"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "r2data": {
      "$room": {
        ".read": true,
        ".write": true,
        "$mid": {
          "password": {
            ".validate": false
          },
          "pwd": {
            ".validate": false
          }
        }
      }
    },
    "r2chat": {
      "$room": {
        ".read": true,
        ".write": true,
        "$id": {
          ".validate": "newData.hasChildren(['u','x'])",
          "u": {
            ".validate": "newData.isString()"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "x": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "exam_subjects": {
      ".read": true,
      ".write": true
    },
    "exam_chapters": {
      ".read": true,
      ".write": true
    },
    "exam_questions": {
      ".read": true,
      ".write": true
    },
    "exam_chapter_tests": {
      ".read": true,
      ".write": true
    },
    "examSets": {
      ".read": true,
      ".write": true
    },
    "assigned_exams": {
      ".read": true,
      ".write": true
    },
    "exam_sessions": {
      ".read": true,
      ".write": true
    },
    "exam_leaderboard": {
      ".read": true,
      ".write": true
    },
    "class_change_requests": {
      ".read": true,
      ".write": true
    },
    "admin_config": {
      ".read": true,
      ".write": true
    },
    "shortcuts": {
      ".read": true,
      ".write": true
    },
    "user_profiles": {
      ".read": true,
      ".write": true
    },
    "user_pins": {
      ".read": true,
      ".write": true
    },
    "quotes": {
      ".read": true,
      ".write": true
    },
    "exam_blocked_targets": {
      ".read": true,
      ".write": true
    },
    "user_exam_history": {
      ".read": true,
      ".write": true
    },
    "exam_chapter_durations": {
      ".read": true,
      ".write": true
    },
    "exam_sets": {
      ".read": true,
      ".write": true
    },
    "admin": {
      ".read": true,
      ".write": true
    },
    "admins": {
      ".read": true,
      ".write": true
    },
    "admin_alerts": {
      ".read": true,
      ".write": true
    },
    "motivational_quotes": {
      ".read": true,
      ".write": true
    },
    "numeric_uids": {
      ".read": true,
      ".write": true
    },
    "vip_users": {
      ".read": true,
      ".write": true
    },
    "vip_custom_subjects": {
      ".read": true,
      ".write": true
    },
    "exam_times": {
      ".read": true,
      ".write": true
    },
    "chapter_exams": {
      ".read": true,
      ".write": true
    }
  }
}